{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Robot: Run Current File",
            "type": "shell",
            "command": "robot -d results\\%USERNAME: =_%_%RANDOM% --loglevel INFO \"${file}\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Robot: Run All Tests",
            "type": "shell",
            "command": "robot -d results\\%USERNAME: =_%_%RANDOM% --loglevel INFO .",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
